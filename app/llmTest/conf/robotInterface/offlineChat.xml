<!DOCTYPE robot PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">
<robot name="R1LLMOffline" build="2" portprefix="/offline_chat" xmlns:xi="http://www.w3.org/2001/XInclude">
    <devices>
        <device name="r1Chat" type="llama2Device">
            <param extern-name="Llama2Device_model_context" name="model_context">
                llama.cpp
            </param>
            <param extern-name="Llama2Device_model_name" name="model_name">
                gpt-oss-20b-F16.gguf
            </param>
            <param extern-name="Llama2Device_npredict" name="npredict">
                100
            </param>
            <param extern-name="r1_prompt_ctx" name="prompt_context">llmTest</param>
            <param extern-name="r1_prompt" name="prompt_file">r1_talk_prompt.txt</param>
        </device>
        <device name="LLM_nws" type="LLM_nws_yarp">
            <param extern-name="LLMNwsYarp_name" name="name">
                /r1_chat/LLM_nws
            </param>
            <action phase="startup" level="5" type="attach">
                <paramlist name="networks">
                    <elem name="subdeviceLLM">
                        r1Chat
                    </elem>
                </paramlist>
            </action>
            <action phase="shutdown" level="5" type="detach" />
        </device>
    </devices>
</robot>
